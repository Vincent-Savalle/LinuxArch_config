{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    "height": 30, // Waybar height
    // "width": 1366, // Waybar width
    // Choose the order of the modules
    "modules-left": ["hyprland/workspaces","tray"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio","custom/ethernet","network", "cpu","custom/gpu", "memory"],

    "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "sort-by-number": true,
    "persistent-workspaces": {
     "*": [1, 2, 3, 4, 5]
    },
    "icon-size": 10,
    },

    "tray": {
        // "icon-size": 21,
        "spacing": 10,
	"show-passive-items": true,
	
    },
    "clock": {
	 "format": "{:%d.%m.%Y  |  %H:%M}"
    },
    "cpu": {
	 "format": "{usage}% ",
         "interval": 1,
    },
    "custom/gpu": {
	"format": "{}",
	"exec": "/home/diziouf/.config/waybar/Gpu-util.sh",
	"interval": 1,
    },
    "memory": {
	 "format": "{used:0.2f}G ",
	 "interval": 1,
    },
  "custom/ethernet": {
	"exec": "/home/diziouf/.config/waybar/Ether-util.sh",	
	"format": "{}",
  	"interval": 1,
	"tootip": false,
  },
    "network": {
        "format-ethernet": "",
        "format-disconnected": ""
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{volume}% {icon}",
        "format-icons": {"default": ["", ""] },
        "on-click": "bash ~/.config/waybar/Audio-change.sh"
    },
    "hyprland/language": {
        "format": "{short}"
    },
 },
}
